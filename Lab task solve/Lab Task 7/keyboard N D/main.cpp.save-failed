    // Roof
    glColor3f(0.4f, 0.4f, 0.4f);
    glBegin(GL_QUADS);
    glVertex2f(180, 230);
    glVertex2f(280, 230);
    glVertex2f(270, 250);
    glVertex2f(190, 250);
    glEnd();
    // Pillars
    glColor3f(0.6f, 0.6f, 0.6f);
    glBegin(GL_QUADS);
    glVertex2f(190, 170);
    glVertex2f(200, 170);
    glVertex2f(200, 230);
    glVertex2f(190, 230);
    glEnd();
    glBegin(GL_QUADS);
    glVertex2f(260, 170);
    glVertex2f(270, 170);
    glVertex2f(270, 230);
    glVertex2f(260, 230);
    glEnd();
}

void shadhin_drawShoppingMall() {
    // Base building
    glColor3f(0.7f, 0.7f, 0.8f);
    glBegin(GL_QUADS);
    glVertex2f(350, 170);
    glVertex2f(650, 170);
    glVertex2f(650, 350);
    glVertex2f(350, 350);
    glEnd();
    // Windows
    glColor3f(0.5f, 0.7f, 0.9f);
    for (int i = 0; i < 3; ++i) {
        drawRectangle(370 + i * 100, 200, 40, 60, 0.5f, 0.7f, 0.9f);
    }
    // Entrance
    glColor3f(0.3f, 0.3f, 0.3f);
    drawRectangle(475, 170, 50, 70, 0.3f, 0.3f, 0.3f);
}

void shadhin_drawStadium() {
    glColor3f(0.8f, 0.8f, 0.8f);
    // Outer oval
    glBegin(GL_TRIANGLE_FAN);
    for (int i = 0; i <= 360; ++i) {
        float angle = i * 3.1415926535f / 180.0f;
        glVertex2f(500 + 200 * cos(angle), 100 + 80 * sin(angle));
    }
    glEnd();
    glColor3f(0.2f, 0.6f, 0.2f);
    // Inner field
    glBegin(GL_TRIANGLE_FAN);
    for (int i = 0; i <= 360; ++i) {
        float angle = i * 3.1415926535f / 180.0f;
        glVertex2f(500 + 150 * cos(angle), 100 + 60 * sin(angle));
    }
    glEnd();
}

void shadhin_drawSkyscraper(float x, float y, float height) {
    glColor3f(0.3f, 0.3f, 0.5f); // Dark blue-grey
    drawRectangle(x, y, 80, height, 0.3f, 0.3f, 0.5f);
    // Windows
    glColor3f(0.6f, 0.8f, 1.0f);
    for (int i = 0; i < height / 20; ++i) {
        for (int j = 0; j < 2; ++j) {
            drawRectangle(x + 10 + j * 40, y + 10 + i * 20, 20, 10, 0.6f, 0.8f, 1.0f);
        }
    }
}

void shadhin_drawPond() {
    glColor3f(0.2f, 0.5f, 0.7f);
    drawCircle(750, 100, 60);
    // Ducks
    glColor3f(1.0f, 1.0f, 1.0f);
    drawCircle(720, 100, 5);
    drawCircle(730, 100, 5);
    drawCircle(725, 105, 3); // Head
    glColor3f(1.0f, 0.5f, 0.0f);
    drawCircle(727, 106, 1); // Beak
}

void shadhin_drawFountain() {
    glColor3f(0.7f, 0.7f, 0.7f);
    drawCircle(850, 170, 20); // Base
    glColor3f(0.5f, 0.7f, 0.9f);
    glBegin(GL_LINES);
    for (int i = 0; i < 10; ++i) {
        glVertex2f(850, 170);
        glVertex2f(850 + 10 * cos(i * 36), 170 + 30 + 10 * sin(i * 36));
    }
    glEnd();
}

void shadhin_drawPath() {
    glColor3f(0.6f, 0.4f, 0.2f);
    glBegin(GL_QUADS);
    glVertex2f(0, 170);
    glVertex2f(1000, 170);
    glVertex2f(1000, 185);
    glVertex2f(0, 185);
    glEnd();
}

void shadhin_drawLampPost(float x, float y) {
    glColor3f(0.3f, 0.3f, 0.3f);
    drawRectangle(x, y, 5, 80, 0.3f, 0.3f, 0.3f);
    glColor3f(1.0f, 1.0f, 0.8f); // Light
